@startuml
title Questao 2 - Casa de Leiloes Online
skinparam classAttributeIconSize 0
skinparam linetype ortho
class AcertoVendedor <<Client>> {
  private final Venda venda
  public AcertoVendedor(Venda venda)
  public BigDecimal getLiquido()
  public String gerar()
  public void imprimir()
}
class AuditorLances <<ConcreteObserver>> {
  private final List<String> registros
  public void atualizar(Lote lote, Lance lance)
  public List<String> getRegistros()
}
class CertificadoAutenticidade <<ConcreteDecorator>> {
  public CertificadoAutenticidade(Fatura fatura)
  protected ItemFatura criarItem()
}
class ComissaoArte <<ConcreteStrategy>> {
  public BigDecimal calcular(BigDecimal valorVenda)
}
class ComissaoEletronicos <<ConcreteStrategy>> {
  public BigDecimal calcular(BigDecimal valorVenda)
}
class ComissaoImoveis <<ConcreteStrategy>> {
  public BigDecimal calcular(BigDecimal valorVenda)
}
class ComissaoVeiculos <<ConcreteStrategy>> {
  public BigDecimal calcular(BigDecimal valorVenda)
}
class Dinheiro <<Utility>> {
  private Dinheiro()
  public static BigDecimal validar(BigDecimal valor)
  public static BigDecimal arredondar(BigDecimal valor)
  public static String formatar(BigDecimal valor)
}
class EmbalagemEspecial <<ConcreteDecorator>> {
  public EmbalagemEspecial(Fatura fatura)
  protected ItemFatura criarItem()
}
class EntregaExpressa <<ConcreteDecorator>> {
  public EntregaExpressa(Fatura fatura)
  protected ItemFatura criarItem()
}
enum EstadoLote <<State>> {
  ABERTO
  VENDIDO
  NAO_VENDIDO
}
interface Fatura <<Component>> {
  Venda getVenda()
  List<ItemFatura> getItens()
  BigDecimal getTotal()
}
class FaturaVenda <<ConcreteComponent>> {
  private final Venda venda
  public FaturaVenda(Venda venda)
  public Venda getVenda()
  public List<ItemFatura> getItens()
  public BigDecimal getTotal()
}
class ImpressorFatura <<Client>> {
  public String gerar(Fatura fatura)
  public void imprimir(Fatura fatura)
}
class ItemFatura <<ValueObject>> {
  private final String descricao
  private final BigDecimal custo
  public ItemFatura(String descricao, BigDecimal custo)
  public String getDescricao()
  public BigDecimal getCusto()
}
class Lance <<ValueObject>> {
  private final Licitante participante
  private final BigDecimal valor
  private final Instant dataHora
  public Lance(Licitante participante, BigDecimal valor)
  public Licitante getParticipante()
  public BigDecimal getValor()
  public Instant getDataHora()
}
interface Licitante <<ObserverContract>> {
  String getNome()
}
class Lote <<ConcreteSubject_Context>> {
  private final String nome
  private final String categoria
  private final BigDecimal precoInicial
  private final BigDecimal precoReserva
  private final List<ObservadorLote> observadores
  private final List<Lance> lances
  private RegraComissao regraComissao
  private EstadoLote estado
  private Venda venda
  public Lote(String nome, String categoria, BigDecimal precoInicial, BigDecimal precoReserva, RegraComissao regraComissao)
  public void acompanhar(ObservadorLote observador)
  public void deixarDeAcompanhar(ObservadorLote observador)
  public boolean receberLance(Licitante participante, BigDecimal valor)
  public void trocarRegraComissao(RegraComissao novaRegra)
  public Optional<Venda> encerrar()
  public String getNome()
  public String getCategoria()
  public BigDecimal getPrecoInicial()
  public BigDecimal getPrecoReserva()
  public BigDecimal getLanceAtual()
  public List<Lance> getLances()
  public EstadoLote getEstado()
}
class Main <<CompositionRoot>> {
  public static void main(String[] args)
}
interface ObservadorLote <<Observer>> {
  void atualizar(Lote lote, Lance lance)
}
interface ObservavelLote <<Subject>> {
  void acompanhar(ObservadorLote observador)
  void deixarDeAcompanhar(ObservadorLote observador)
}
class PainelLeiloeiro <<ConcreteObserver>> {
  private final Map<String, String> resumos
  public void atualizar(Lote lote, Lance lance)
  public Map<String, String> getResumos()
}
class Participante <<ConcreteObserver>> {
  private final String nome
  private final List<String> notificacoes
  public Participante(String nome)
  public String getNome()
  public boolean darLance(Lote lote, BigDecimal valor)
  public void atualizar(Lote lote, Lance lance)
  public List<String> getNotificacoes()
}
interface RegraComissao <<Strategy>> {
  BigDecimal calcular(BigDecimal valorVenda)
}
class SeguroTransporte <<ConcreteDecorator>> {
  public SeguroTransporte(Fatura fatura)
  protected ItemFatura criarItem()
}
abstract class ServicoAdicional <<Decorator>> {
  private final Fatura fatura
  protected ServicoAdicional(Fatura fatura)
  public final Venda getVenda()
  protected abstract ItemFatura criarItem()
  public final List<ItemFatura> getItens()
  public final BigDecimal getTotal()
}
class Venda <<ValueObject>> {
  private final String nomeLote
  private final Licitante comprador
  private final BigDecimal valor
  private final BigDecimal comissao
  Venda(String nomeLote, Licitante comprador, BigDecimal valor, BigDecimal comissao)
  public String getNomeLote()
  public Licitante getComprador()
  public BigDecimal getValor()
  public BigDecimal getComissao()
}
class Testes <<TestRunner>> {
  + {static} main(args : String[]) : void
  - {static} verificar(condicao : boolean, mensagem : String) : void
  - {static} valor(atual : BigDecimal, esperado : String, mensagem : String) : void
  - {static} falha(acao : Runnable, mensagem : String) : void
  - {static} lote(nome : String, inicial : String, reserva : String, regra : RegraComissao) : Lote
}
